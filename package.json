{
  "name": "drive-semantic-search-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "format:check": "node -e \"console.log('Prettier not required in CI; run npx prettier --write src if desired')\""
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "firebase": "12.19.0",
    "lucide-react": "0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
