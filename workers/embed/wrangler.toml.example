name = "drive-semantic-embed"
main = "src/index.ts"
compatibility_date = "2024-09-01"

# Secrets (set via `wrangler secret put`, never commit):
#   GEMINI_API_KEY
#   FIREBASE_PROJECT_ID   (e.g. thevvforg — for ID token audience check)

[vars]
EMBED_MODEL = "text-embedding-004"
EMBED_DIMENSION = "768"
MAX_TEXTS = "32"
MAX_CHARS = "8000"
